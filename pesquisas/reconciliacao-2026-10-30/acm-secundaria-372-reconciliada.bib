@inproceedings{10.1145/3748522.3779878,
author = {Eichhammer, Philipp and Reiser, Hans P.},
title = {SimGuard: Towards Resilience of Community-based Intrusion Detection},
year = {2026},
isbn = {9798400722943},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3748522.3779878},
doi = {10.1145/3748522.3779878},
abstract = {The rise of sizable and complex IoT infrastructures increased research interest in Collaborative Intrusion Detection Systems (CIDSs). Therefore, federated learning (FL) mechanisms offer a privacy-preserving method of collaboration, which, however, is subject to poisoning attacks that degrade model accuracy. While there are solutions effective in detecting and mitigating poisoning attacks, their methodology always assumes a static infrastructure in terms of benign behavior. This work presents a method for detecting malicious data injection into training data under the assumption of concept drift, a phenomenon where real-world infrastructures experience gradual, benign changes in their behavior and structure throughout their life cycle. Our approach can successfully differentiate between maliciously provoked changes and changes in behavior induced by concept drift. This feature is made possible by leveraging the concept of similarity between anomaly detection models in conjunction with federated learning (FL) technology. Our results demonstrate that our approach can detect poisoning attacks with an accuracy of 97%, while correctly identifying concept drift in 98% of cases. With our detection methods, we can maintain high true positive rates while keeping the false positive rate low over time in real-world infrastructures.},
booktitle = {Proceedings of the 41st ACM/SIGAPP Symposium on Applied Computing},
pages = {385–394},
numpages = {10},
keywords = {collaborative intrusion detection, data poisoning, concept drift},
location = {Thessaloniki, Greece},
series = {SAC '26}
}


