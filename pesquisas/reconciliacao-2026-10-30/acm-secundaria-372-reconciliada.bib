@inproceedings{10.1145/3697090.3699800,
author = {Freitas, Ana Vitoria and de Ara{\'u}jo J{\'u}nior, Silvio Romero and Silva, Hebert},
title = {MQTT-VET: Exploring MQTT Protocol Vulnerabilities},
year = {2024},
isbn = {9798400717406},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3697090.3699800},
doi = {10.1145/3697090.3699800},
abstract = {The Message Queuing Telemetry Transport (MQTT) protocol is essential for IoT communications, enabling lightweight device messaging. However, its widespread use increases security vulnerabilities. This paper introduces the MQTT Vulnerability Exploration Testbed (MQTT-VET), a container-based environment to analyze and exploit MQTT weaknesses in IoT setups. It simulates real-world scenarios to identify critical security flaws in MQTT implementations, offering practical security tools and guidelines for developers and network administrators. The preliminary results suggest that container-based testbeds can improve IoT security across various sectors.},
booktitle = {Proceedings of the 13th Latin-American Symposium on Dependable and Secure Computing},
pages = {111–113},
numpages = {3},
keywords = {MQTT Protocol, IoT, Vulnerabilities, testbed, Cybersecurity},
location = {Recife, Brazil},
series = {LADC '24}
}


@article{10.1145/3797823.3797850,
author = {Dikshant and Verma, Geetika},
title = {Alert or Noise? Reducing False Positives with ActiveBehavioral Analysis for Cloud Security},
year = {2026},
issue_date = {March 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {53},
number = {4},
issn = {0163-5999},
url = {https://doi.org/10.1145/3797823.3797850},
doi = {10.1145/3797823.3797850},
abstract = {Rule-based cloud security posture management (CSPM) solutions are known to produce a lot of false positives based on the limited contextual understanding and dependence on static heuristics testing. This paper introduces a validationdriven methodology that integrates active behavioral testing in cloud security posture management solution(s) to evaluate the exploitability of policy violations in real time. The proposed system employs lightweight and automated probes, built from open-source tools, validation scripts, and penetration testing test cases, to simulate adversarial attacks on misconfigured or vulnerable cloud assets without any impact to the cloud services or environment. For instance, cloud services may be flagged as publicly exposed and vulnerable despite being protected by access control layers, or secure policies, resulting in non-actionable alerts that consume analysts' time during manual validation. Through controlled experimentation in a reproducible AWS setup, we evaluated the reduction in false positive rates across various misconfiguration and vulnerable alerts. Our findings indicate an average reduction of 93% in false positives. Furthermore, the framework demonstrates low latency performance. These results demonstrate a scalable method to improve detection accuracy and analyse productivity in large cloud environments. While our evaluation focuses on AWS, the architecture is modular and extensible to multi-cloud setups.},
journal = {SIGMETRICS Perform. Eval. Rev.},
month = mar,
pages = {84–90},
numpages = {7},
keywords = {cloud security posture management, false positive reduction, behavioral validation, active security testing, exploitability assessment, alert triage}
}


@inproceedings{10.1145/3778534.3778608,
author = {Zhou, Jie and Zhou, Zihao},
title = {Intelligent closed-loop implementation method for the entire log life cycle},
year = {2026},
isbn = {9798400719356},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3778534.3778608},
doi = {10.1145/3778534.3778608},
abstract = {To address the challenges of log lifecycle management, such as massive data volumes, heterogeneous formats, security vulnerabilities, and response delays, we propose an intelligent closed-loop implementation model, forming a comprehensive architecture from data collection to feedback. This approach leverages Fluentd and Kafka to achieve efficient data collection, employs DistilBERT and BiLSTM technologies for semantic analysis and time series anomaly detection, and employs Storm and GraphDB for rapid alerting and knowledge feedback. The A2C algorithm optimizes the closed-loop strategy. Experimental validation using the 2024 MultiLog dataset, comprised of 900 million log entries, demonstrates that the model achieves an accuracy rate of 94.2% when processing terabyte-scale logs, reduces the false positive rate to 3.5%, and reduces processing latency to 120 milliseconds, reducing annual operational costs by approximately $250,000. The system adopts real-time feedback and adaptive adjustment, which significantly improves the operation and maintenance efficiency of distributed databases, greatly reduces the time and resource consumption required for fault recovery, and realizes the efficiency of large-scale log management. The research has made significant progress in the theory and practice of intelligent closed-loop log management, and has significant practical application value and promotion potential.},
booktitle = {Proceedings of the 4th International Conference on Artificial Intelligence and Intelligent Information Processing},
pages = {475–482},
numpages = {8},
keywords = {Log lifecycle, anomaly detection, distributed system, intelligent closed-loop, knowledge graph, reinforcement learning},
location = {Qingdao, China},
series = {AIIIP '25}
}


