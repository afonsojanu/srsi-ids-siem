abstract = {With the rise of cyber-attacks on cloud systems globally, Cloud Service Providers, Data carrier and hosting providers are forced to provide consideration to the novel challenges posed and requirements for attacks and more specifically DDoS protection in large hosting environment setups. This paper proposes use of multi-tiered network design based on Hybrid cloud solution comprising of an On-premise solution as well as a public cloud infrastructure capable of handling hurricane sized DDoS storms.},
