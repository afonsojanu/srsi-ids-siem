@INPROCEEDINGS{11053120,
  author={K, Mugeshwaran and Maharajan, K. and Nithish, Dumala and S, Dinesh and Uday, N.},
  booktitle={2025 International Conference on Computational Robotics, Testing and Engineering Evaluation (ICCRTEE)}, 
  title={An Integrated Approach to AI-Enhanced Security Information and Event Management}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={An SIEM system enabled by Artificial Intelligence (AI) was proposed to solve the major challenges of current security monitoring practices. The proposed architecture incorporates the use of artificial intelligence at all levels of the security operation center to transform traditional security operations from passive detection to active protection. The system design incorporates the application of machine learning for pattern recognition, contextual analysis, and alert prioritization to overcome the major challenges of traditional SIEM solutions that are based on rules and produce numerous alerts. The detection efficiencies for complicated attack patterns, including APT and zero-day attacks, were found to be significantly higher than those of the conventional systems in the experimental analysis. Integration with high-performance computing provides real-time security data analysis without compromising the performance, whereas the mean time to detection and response is significantly reduced. The effectiveness of the system in detecting threats early, classifying them correctly, and recommending response actions in multiple case studies involving various attacks was demonstrated. The architecture is a major improvement over current security monitoring technologies, and it provides more effective protection against ever-increasing threats with less analyst workload through contextualized and automated alerts.},
  keywords={Technological innovation;Security information and event management;Computer architecture;Transforms;Real-time systems;Threat assessment;Security;Protection;Monitoring;Testing;Security information and event management (SIEM);AI-powered SIEM;deep learning security analytics;real-time threat detection;AI-driven security event processing;adaptive threat defense;machine learning for cybersecurity;automated incident response;Innovation & Infrastructure;Resilient Digital Infrastructure;Secure & Sustainable Societies},
  doi={10.1109/ICCRTEE64519.2025.11053120},
  ISSN={},
  month={May},}@INPROCEEDINGS{11582879,
  author={Lakkaraju, Yatin and Prasad, Gaurav and Sarma, Akash},
  booktitle={2026 IEEE International Conference on Emerging Synergy Science and Technology (ICESST)}, 
  title={Comprehensive Survey of Security Information and Event Management (SIEM) Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={With the evolving digital landscape, the threat of cyber attacks has never been greater. Attackers are nowadays using sophisticated techniques to carry complicated and multilayered attacks which make traditional cyber-defense tools like firewalls, IDS, and IPS inefficient. The traditional tools lack in capabilities of correlation of data, event management and investigations, and efficient usage of External data like Threat Intelligence. Organizations nowadays employ different security information and event management (SIEM) tools to combat such complex attacks. SIEM tools can ingest huge amounts of data from different sources including traditional security tools like IDS, Firewall, and IPS. These tools have advanced defense capabilities as they employ different features like data correlation, Threat Intelligence, Compliance, etc. This paper first provides a small analysis of the features of different SIEM tools widely used in the industry. It also provides different SIEM frameworks proposed in the academic field that use various technologies like AI, Cloud, etc.},
  keywords={Security information and event management;Security;Modeling;Tools;Correlation;Artificial intelligence;Organizations;Machine learning;Printing;Clouds;SIEM;AI in SIEM;Cloud-based SIEM;Anomaly Detection;SOAR;Security Analytics;Event Correlation},
  doi={10.1109/ICESST69086.2026.11582879},
  ISSN={},
  month={April},}@INPROCEEDINGS{11300009,
  author={Vasilakis, Manos and Tampouratzis, Manolis and Dimitriadis, Athanasios},
  booktitle={2025 6th International Conference on Communications, Information, Electronic and Energy Systems (CIEES)}, 
  title={Integrated Threat Intelligence and Event Correlation with Wazuh, Suricata, and MISP}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Modern cyber threats are becoming increasingly sophisticated, requiring complicated defense techniques to be able to detect them, making traditional defense methods inadequate. This research presents an automated architecture with open source solutions, integrating a Security Information and Event Management (SIEM) system based on Wazuh that executes correlation rules and matches correlations from Suricata alerts and the lists of the MISP for confirmed threats, Suricata, a high-performance Intrusion Detection System (IDS) designed for network detection and malicious pattern detection, and a Malware Information Sharing Platform (MISP), which is continuously enriched by the updated URLhaus database of indicators of compromise (IoCs), which contains datasets with malicious URLs and receives data from MISP through an automated continuous flow. Automated Python scripts have been created to run via cron jobs and their purpose is to extract IoCs by connecting to the MISP API and then converting them into Suricata rules. The proposed integration improves event correlation and accurately detects all malicious IoCs in the specific database, leading to a more efficient detection of known threats.},
  keywords={Correlation;Automation;Event detection;Databases;Security information and event management;Malware;Threat assessment;Real-time systems;Security;Pattern matching;MISP;threat intelligence;Wazuh detection;Suricata IDS;indicator of compromise (IoC);cyber threat detection;open source security tools},
  doi={10.1109/CIEES66347.2025.11300009},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11648039,
  author={Akhmetov, Murat and Omarzhanov, Yerassyl and Aikenov, Yerassyl and Shegebay, Arsen},
  booktitle={2026 International Conference on Cybersecurity, Digital Forensics, and AI Applications (ICCSDFAI)}, 
  title={Development of an Automatic Notification System for Unauthorized Activities on the Local Network}, 
  year={2026},
  volume={},
  number={},
  pages={1053-1057},
  abstract={This paper presents the design and implementation of an automatic notification system for detecting unauthorized activities on local networks. The proposed solution integrates the open-source Wazuh Security Information and Event Management (SIEM) platform with a Telegram-based alerting system set up in a virtualised environment using Oracle VirtualBox. By installing Wazuh agents on monitored endpoints, you can collect and analyse security events in real time. When the system sees something strange, system administrators and SOC analysts can get instant mobile alerts. This is possible because a custom integration script sends warnings to a Telegram bot. The system showed that it could handle a wide range of events from start to finish and that alerts would be sent within five seconds. The solution is a cheap, scalable, and easy-to-access alternative to commercial SOC infrastructure for small and medium-sized businesses (SMEs) and situations where resources are limited.},
  keywords={Security information and event management;Printing;Monitoring;Security;Bot (Internet);Chatbots;Computer security;System-on-chip;Windows;intrusion detection system;SIEM;Wazuh;Telegram bot;network security;real-time alerting;virtualization;SOC},
  doi={10.1109/ICCSDFAI70505.2026.11648039},
  ISSN={},
  month={June},}@INPROCEEDINGS{7792462,
  author={Gonzalez Granadillo, Gustavo and El-Barbori, Mohammed and Debar, Herve},
  booktitle={2016 8th IFIP International Conference on New Technologies, Mobility and Security (NTMS)}, 
  title={New Types of Alert Correlation for Security Information and Event Management Systems}, 
  year={2016},
  volume={},
  number={},
  pages={1-7},
  abstract={Current Security Information and Event Management systems (SIEMs) constitute the central platform of modern security operations centers. They gather events from multiple sensors (intrusion detection systems, anti-virus, firewalls, etc.), correlate these events, and deliver synthetic views of the alerts for threat handling and security reporting. However, as the number of security incidents, and thus the diversity of alerts received by SIEMs increases, the need for appropriate treatment of these alerts has become essential. Alert correlation has been proposed in order to alleviate this problem. Current alert correlation techniques provide a better description of the detected incident and a concise view of the generated alerts, reducing their volume and thus their processing time. Although such techniques support administrators in processing a huge number of alerts, they remain limited, since these solutions do not provide information about the attacker's behavior and the defender's capability in reacting to detected attacks. In this paper, we propose two novel alert correlation approaches. The first is based on policy enforcement and defender capability models; and the second is based on information security indicators. We therefore enrich the current state of the art in alert correlation techniques with complementary approaches.},
  keywords={Correlation;Security;IP networks;Ports (Computers);Standards;Software},
  doi={10.1109/NTMS.2016.7792462},
  ISSN={2157-4960},
  month={Nov},}@INPROCEEDINGS{11288163,
  author={Diakhame, Mouhamadou Lamine and Diallo, Chérif and Mejri, Mohamed},
  booktitle={2025 9th Cyber Security in Networking Conference (CSNet)}, 
  title={Machine Learning-Based Alert Correlation for Enhanced Cybersecurity: A Multi-Classification Approach}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Modern Security Operations Centers (SOCs) struggle with an overwhelming influx of security alerts from diverse sources, leading to alert fatigue and delayed incident response times. Conventional Security Information and Event Management (SIEM) systems typically process alerts in isolation, missing complex attack patterns that unfold across multiple detection points. This research introduces a comprehensive machine learning framework for intelligent alert correlation using three classification approaches: binary correlation detection, correlation type classification, and incident classification. We evaluated eight machine learning algorithms—Logistic Regression, Random Forest, XGBoost, LightGBM, Artificial Neural Networks (ANN), Convolutional Neural Networks (CNN), CatBoost, and Support Vector Machines (SVM)—using 50,000 realistic security alerts generated from 2.30 million network flows in the CIC-IDS-2017 dataset. Our multi-classification framework incorporates temporal relationships, network topology, attack progression patterns, and severity indicators to enhance correlation precision. The experimental results reveal remarkable performance across all classification tasks. CatBoost achieved the highest overall performance with 99.27% average accuracy across all tasks, closely followed by Random Forest (99.17%) and LightGBM (99.06%). For multiclass correlation type classification, six out of eight models achieved perfect 100% accuracy, with only XGBoost and SVM showing decreases to 96.30%. Binary correlation detection demonstrated exceptional performance with three models (Random Forest, LightGBM, CatBoost) achieving 99.96% accuracy. The proposed framework demonstrates exceptional capability in reducing alert noise while maintaining optimal detection rates, significantly enhancing SOC operational efficiency and enabling more targeted threat response strategies.},
  keywords={Analytical models;Correlation;Accuracy;Machine learning algorithms;Computational modeling;Security information and event management;Feature extraction;Convolutional neural networks;Computer crime;Random forests;Alert Correlation;Machine Learning;Cybersecurity;SIEM;Classification;Incident Response},
  doi={10.1109/CSNet67572.2025.11288163},
  ISSN={2768-0029},
  month={Oct},}@INPROCEEDINGS{9310950,
  author={Mulyadi, Ferdy and Annam, Leela Aditya and Promya, Ridnarong and Charnsripinyo, Chalermpol},
  booktitle={2020 - 5th International Conference on Information Technology (InCIT)}, 
  title={Implementing Dockerized Elastic Stack for Security Information and Event Management}, 
  year={2020},
  volume={},
  number={},
  pages={243-248},
  abstract={In security information and event management (SIEM), real-time monitoring together with analysis of log data for correlation of events can provide anomaly detection and notification. A centralized log system with big-data databases is required for SIEM in order to store and manage the log data. In this paper, we present dockerized Elastic Stack for security information and event management. The main reasons are because of lightweight, simplicity and supporting features. One of important Elasticsearch features is security information. Elasticsearch can act as Intrusion Detection System (IDS) together with log/event management as SIEM. Our experiments show that dockerized elastic stack can be efficiently used for security information and event management.},
  keywords={Security;Servers;Tools;Containers;Monitoring;Open source software;Bridges;big data;data log system;elasticsearch;event management;security information;siem},
  doi={10.1109/InCIT50588.2020.9310950},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11273397,
  author={Bakraouy, Zineb and Abbass, Wissam and Boughanja, Manale and Flissat, Mohammed and Baina, Amine and Bellafkih, Mostafa},
  booktitle={2025 International Conference on Intelligent Systems: Theories and Applications (SITA)}, 
  title={Hybrid NIDS Architecture Leveraging Suricata, Zeek and the ELK Stack}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Network protection has become a cardinal priority in organizations due to the growing sophistication of cyber threats. We implement a Network Intrusion Detection System by showing how three open-source tools can be used: Suricata performs deep packet inspection and uses signaturebased threat detection, Zeek (formerly Bro) provides advanced network traffic analysis and logging, and Elastic Stack (Filebeat, Elasticsearch, Kibana) allows real-time data indexing, search, and interactive visualization. For comprehensive threat detection, our integrated solution uses the Suricata rule-based engine with the behavioral analysis provided by Zeek. We offer centralized monitoring using the scalable log management of Elastic Stack and the Kibana dashboards. Thus, this contribution achieves enterprise-grade network visibility without vendor lock-in and is specifically suitable for organizations operating on a limited security budget. Future improvements will be related to machine learning integration for anomaly detection, and support for encrypted traffic analysis will be extended.},
  keywords={Network intrusion detection;Organizations;Telecommunication traffic;Machine learning;Inspection;Threat assessment;Real-time systems;Protection;Intelligent systems;Monitoring;Network Intrusion Detection System (NIDS);Suricata;Zeek;Elastic Stack;cybersecurity;open-source security;network monitoring;threat detection;SIEM;packet analysis},
  doi={10.1109/SITA67914.2025.11273397},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10927195,
  author={Toyin, Okebule and Adeola, Moyede Olivia and Oguntimilehin, Abiodun and O B, Abiola and Aweh, Opani M. and Obamiyi, Stephen E. and Oluwafemi A, Sanya and Akinduyite, Christianah O. and James, Atachin A.},
  booktitle={2024 IEEE 5th International Conference on Electro-Computing Technologies for Humanity (NIGERCON)}, 
  title={Intelligent Network Intrusion Detection and Prevention System (NIDPS): A Machine Learning and Network Security}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Distributed Denial-of-Service (DDoS) attacks pose a significant threat to network security. The need for Internet security has grown as a result of attackers having more opportunities to cause harm due to the rapid growth in Internet users over the past twenty years. In this study, we utilized Snort, a widely used network intrusion detection system, to capture and analyze network traffic, and Wazuh, a security information and event management system, to integrate the machine learning model and preventive mechanism script for active response. This study examined the effectiveness of integrating machine learning techniques and traditional signature-based approaches for real-world Network Intrusion Detection and Prevention Systems (NIDPS) applications in detecting and mitigating these attacks. The Random Forest model demonstrated exceptional performance on the prepared dataset, achieving an accuracy, recall, precision, and F1-score of around 99.99% with a training time of approximately 18.84 seconds. The system's integration with Snort and Wazuh allowed for consistent monitoring and analysis of network traffic, and the active response module enabled the system to make machine learning-based predictions and execute preventive measures in real-time. These results suggested the viability of utilizing machine learning, particularly Random Forest algorithms, for effective DDoS attack detection within Network Intrusion Detection and Prevention Systems (NIDPS) frameworks.},
  keywords={Training;Machine learning algorithms;Prevention and mitigation;Network intrusion detection;Telecommunication traffic;System integration;Network security;Denial-of-service attack;Real-time systems;Random forests;Intrusion detection;Distributed denial-of-service (DDoS) attacks;Real-time analytics;Signature based detection;Machine learning},
  doi={10.1109/NIGERCON62786.2024.10927195},
  ISSN={2377-2697},
  month={Nov},}@INPROCEEDINGS{11518227,
  author={Chandran, Aravind and Aravind, T.K.Shree and Vignesh, R. Yoga and Kavya, G. Veera and Aman, M Khasim},
  booktitle={2026 Third International Conference on Networking and Communications (ICNWC)}, 
  title={Real-Time Port Scan Detection and Automated Response Framework Using Log-Based Analysis and SIEM Integration}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Port scanning is one of the most commonly used techniques by attackers to identify vulnerable services within a target network. Detecting such activities at an early stage is essential to prevent further intrusion attempts. This paper presents a real-time port scan detection and automated response framework that integrates log-based network traffic analysis with Security Information and Event Management (SIEM) capabilities using Splunk. The proposed system uses a Python-based detection engine to continuously analyse network events and identify malicious scanning behaviour based on temporal patterns and abnormal port access activities. Detected scan events are recorded in a structured format and forwarded to Splunk, where centralized indexing, correlation, visualization, and alerting are performed. Additionally, the framework supports an automated firewall mechanism that dynamically blocks malicious source IP addresses, creating a closed-loop detection and response system. Security teams can monitor, analyse, and investigate scanning incidents in real time through Splunk dashboards and correlation rules. Experimental results show that the proposed model achieves a high detection rate with low response time, while also providing improved visibility and scalability through SIEM integration. This framework can be effectively deployed in enterprise environments and Security Operations Centre (SOCs) to strengthen proactive, data-driven network defence},
  keywords={Signal detection;Ports (computers);Security information and event management;Timing;Real-time systems;Security;Intrusion detection;Firewalls (computing);Testing;Printing;Port Scan Detection;Network Security;Siem;Splunk;Log-Based Analysis;Automated Firewall Response;Intrusion Detection;Cybersecurity;Smart Infrastructure},
  doi={10.1109/ICNWC68145.2026.11518227},
  ISSN={},
  month={April},}@INPROCEEDINGS{11661994,
  author={Junayed, Nabila and Alam, Mohammad Jahangir and Farhan Shahriyar, Md},
  booktitle={2026 International Conference on Power, Electronics, Communications, Computing, and Intelligent Infrastructure (PECCII)}, 
  title={Transfer Learning for Network Intrusion Detection Using Machine Learning, Behavioral Fingerprints and SIEM-Oriented Multi-Source Risk Scoring}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Network intrusion detection remains a critical challenge for enterprise security operations, particularly as attack methodologies continue to evolve in sophistication. This paper presents a machine learning-enhanced network intrusion detection system that combines behavioral fingerprinting with multi-component risk scoring to identify SQL injection and brute force attacks in real-time. The proposed architecture employs a three-layer feature engineering approach, extracting behavioral fingerprints for known attack patterns, computing component-specific risk scores and applying gradient-boosted ensemble classification for final risk quantification. Seven classification algorithms were trained on the NSL-KDD benchmark dataset and evaluated on both NSL-KDD test set and a curated enterprise dataset of network requests. The XGBoost model achieved 99.2% accuracy on NSL-KDD and 99.4% on the custom dataset, demonstrating exceptional benchmark performance and real-world transferability. 10-fold cross-validation confirmed model stability with 99.1% (土0.6%) mean accuracy. The probability-based risk scores enable configurable alerting thresholds for Security Information and Event Management (SIEM) integration with mean processing latency suitable for real-time deployment scenarios.},
  keywords={Fingerprint recognition;Machine learning;NSL-KDD;SQL injection;Signal detection;Force;Modeling;Accuracy;Machining;Printing;Network Intrusion Detection;Machine Learning;SQL Injection;Brute Force Detection;Risk Scoring;SIEM Integration;XGBoost},
  doi={10.1109/PECCII70991.2026.11661994},
  ISSN={},
  month={June},}@INPROCEEDINGS{11517973,
  author={Madhu, Preetish and Krishnan, Prabhakar and N. N., Hari and N, Sethu Subramanian and Jain, Kurunandan},
  booktitle={2026 International Conference on Smart Electronic Devices and Intelligent Systems (ICSEDIS)}, 
  title={Insider Log Poisoning Attack on Enterprise SIEM Pipeline via Compromised Aggregation Database}, 
  year={2026},
  volume={},
  number={},
  pages={1578-1583},
  abstract={Modern IoT deployments rely on logging pipelines for attack detection, with aggregation layers implicitly trusted by SIEM systems like the ELK stack. This work identifies a critical vulnerability in aggregation databases that has received limited attention in prior research. The research project uses a dual store MinIO system including a Raw WORM and Parsed JSON bucket together with the CICIoT2023 and CICIoTDIAD2024 datasets to create a simulation. A privileged insider performs two attack methods: appending semantically corrupted logs and modifying the parsing scripts. These attacks (timestamp shifting and label flipping) reduce malicious event visibility by ∼77.8%, significantly increase false negatives, and render SIEM alerts and dashboards largely ineffective. Our solution requires the implementation of cryptographic log signing together with hash chain verification and dual-path parsing methods.},
  keywords={Internet of Things;Security information and event management;Labeling;Printing;Security;Modeling;Signal detection;Machine learning;Pipelines;Computer worms;SIEM;Log Poisoning;Insider Threat;MinIO;WORM Storage;Aggregation Database;Cybersecurity},
  doi={10.1109/ICSEDIS68157.2026.11517973},
  ISSN={},
  month={April},}@INPROCEEDINGS{10811423,
  author={Maliki, M. Akmal and Sukarno, Parman and Wardana, Aulia Arif},
  booktitle={2024 5th International Conference on Communications, Information, Electronic and Energy Systems (CIEES)}, 
  title={Integration of Heterogeneous IDS with SIEM for DDoS Attack Detection in Computer Networked Multi-Organizational Environments}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={The increasing reliance on computer networks for business operations has led to a rise in Distributed Denial of Service (DDoS) attacks. These attacks pose significant threats to network security, economic stability, and organizational operations. Organizations connected through the same network are particularly vulnerable. In response to these growing threats, detection systems have been developed to integrate heterogeneous Intrusion Detection Systems (IDS) with Security Information and Event Management (SIEM) systems. This integration assists in the detection of DDoS attacks within multi-organizational environments. The system employs the Opensearch dashboard, providing a centralized and efficient interface for the Security Operations Center. System testing was conducted through coordinated DDoS attack simulations by three attackers over a duration of 7-8 minutes. The Snort IDS demonstrated an average detection rate of 95.4%, with an alert correlation mechanism efficiency of 84.6%. Among the IDS systems tested, Zeek IDS consumed the most resources, with an average CPU usage of 24.6% and memory usage of 86.5%. In contrast, the Wazuh Dashboard exhibited lower resource consumption, with an average CPU usage of 0.6% and memory usage of 5.2%.},
  keywords={System testing;Correlation;Accuracy;Scalability;Denial-of-service attack;Computer networks;Threat assessment;Stability analysis;Robustness;Computer crime;DDoS;IDS;SIEM;Multi-Organizations;Computer Network},
  doi={10.1109/CIEES62939.2024.10811423},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11666666,
  author={Pattinama, Aaron Barrichello and Suryani, Vera and Wardana, Aulia Arif},
  booktitle={2026 5th International Conference on Electronics Representation and Algorithm (ICERA)}, 
  title={Intrusion Detection System Using Stratosphere Linux IPS (SLIPS) and Honeypot with SIEM Visualization}, 
  year={2026},
  volume={},
  number={},
  pages={468-474},
  abstract={This study proposes an intrusion detection architecture that integrates a Dionaea honeypot, Stratosphere Linux IPS (SLIPS), and a Security Information and Event Management (SIEM) platform based on Elasticsearch and Kibana in a virtualized environment. The architecture is designed to capture suspicious interactions, analyze attacker behavior, forward structured alert data, and visualize security events through centralized monitoring. The system consists of four virtual machines, namely an attacker node, a honeypot and analysis node, a SIEM node, and a real server node. Controlled attack scenarios were conducted using port scanning, SSH brute-force, and denial-of-service activity. The results show that SLIPS successfully detected all evaluated attack scenarios and generated structured alerts in alerts.json, which were then forwarded by Filebeat to Elasticsearch and visualized in Kibana. The evaluation also examined system performance in terms of CPU usage, RAM usage, and detection latency. The results indicate that Dionaea remained relatively lightweight, SLIPS recorded the highest processing load, and Elasticsearch became the most resource-intensive SIEM component. Filebeat introduced only a small overhead, while Kibana resource usage mainly increased during dashboard rendering. The measured detection delays indicate that the proposed architecture operates in a near real-time manner. These findings show that the integration of honeypot-based interaction capture, SLIPS-based behavioral analysis, and SIEM-based visualization is feasible for building an open-source environment for attacker behavior observation and centralized intrusion monitoring.},
  keywords={Signal detection;Security information and event management;Virtual machines;Visualization;Timing;Machine learning;Central Processing Unit;Random access memory;Intrusion detection;Architecture;intrusion detection system;honeypot;Stratosphere Linux IPS;SIEM;network security},
  doi={10.1109/ICERA72709.2026.11666666},
  ISSN={},
  month={July},}@INPROCEEDINGS{10795830,
  author={Samonte, Mary Jane C. and Dorado, Pritz Lorraine F. and Dulay, John Benjamin M. and Leyva, Alain Marcus M.},
  booktitle={2024 4th International Conference on Computer Systems (ICCS)}, 
  title={Enhancing Threat Detection in Financial Institutions with AI-Driven Security Information and Event Management Integration}, 
  year={2024},
  volume={},
  number={},
  pages={85-92},
  abstract={In today's technological era, the financial industry relies mainly on modern digital technologies, making it a significant target for cyber-attacks. This paper investigates the critical role of Security Information and Event Management (SIEM) systems in improving cybersecurity at financial institutions. While excellent at accumulating and analyzing security events from diverse sources, traditional SIEM solutions are limited in their ability to confront sophisticated and developing cyber threats. Thus, integrating Artificial Intelligence (AI) into SIEM systems represents a significant development as it boosts its capabilities through machine learning algorithms, realtime threat identification, and predictive analytics. Consequently, this increases threat detection accuracy, reduces false positives, and allows more proactive mitigation of possible security breaches. Hence, this study explores the impact and benefits of AI-enhanced SIEM systems in financial institutions, emphasizing their capacity to provide strong cybersecurity measures. In addition, it also provides a comprehensive analysis of the current threat landscape, traditional cybersecurity methods, and the rising role of AI in SIEM technology, shedding light on the future of cybersecurity in the financial industry.},
  keywords={Machine learning algorithms;Prevention and mitigation;Volume measurement;Scalability;Threat assessment;Real-time systems;Computer security;Artificial intelligence;Predictive analytics;Standards;artificial intelligence;security information and event management;cybersecurity;financial institutions},
  doi={10.1109/ICCS62594.2024.10795830},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{8299855,
  author={Sekharan, S. Sandeep and Kandasamy, Kamalanathan},
  booktitle={2017 International Conference on Wireless Communications, Signal Processing and Networking (WiSPNET)}, 
  title={Profiling SIEM tools and correlation engines for security analytics}, 
  year={2017},
  volume={},
  number={},
  pages={717-721},
  abstract={Nowadays, IT organizations generate colossal amounts of data. Handling these chunks of data itself is critical in the IT world. Hence centralizing the log management system improves security thereby enhances data protection in an organization. Such enterprises require a high profiling tool that helps in managing the information and events data to improve the level of security. Security Information and Event Management (SIEM) is a procedure for security analysis that prominence an overview of security in an organization. SIEM tools collect, analyze, normalize and correlates all files and analyze data coming from the various device and give a centralized view of logs. This paper articulates an abstraction of SIEM tools and event correlation engines, furnishing a description of their technical comparative study, focusing on most popular SIEM tools and open source rule-based correlation engines and profiles them.},
  keywords={Security;Correlation;Monitoring;Tools;Engines;Organizations;Forensics;Information Management;Event Management;Log Analysis;Log management;Correlation;SIEM Products;IBM QRadar;HP ArcSight;Splunk;LogRhythm},
  doi={10.1109/WiSPNET.2017.8299855},
  ISSN={},
  month={March},}@INPROCEEDINGS{8374503,
  author={Kotenko, Igor and Fedorchenko, Andrey and Saenko, Igor and Kushnerevich, Alexey},
  booktitle={2018 26th Euromicro International Conference on Parallel, Distributed and Network-based Processing (PDP)}, 
  title={Parallelization of Security Event Correlation Based on Accounting of Event Type Links}, 
  year={2018},
  volume={},
  number={},
  pages={462-469},
  abstract={The paper proposes a novel approach to parallel data processing for solving security event correlation problems based on Big Data technologies. Different security event correlation methods and problems, as well as big data technologies applicable for security monitoring are considered. The main attention is paid to the problems of identifying the links between security event types and assessing the dependence of the link strength on event distribution in time. Implementation of correlation problem solutions on the Spark platform is described, and the results of experimental assessment of security event correlation processes are given.},
  keywords={Nickel;Correlation;Correlation coefficient;Conferences;Big Data;Artificial neural networks;security event correlation;Pearson correlation coefficient;SIEM system;Big Data;parallel data processing},
  doi={10.1109/PDP2018.2018.00080},
  ISSN={2377-5750},
  month={March},}@ARTICLE{10547258,
  author={Panigrahi, Gyana Ranjana and Sethy, Prabira Kumar and Behera, Santi Kumari and Gupta, Manoj and Alenizi, Farhan A. and Suanpang, Pannee and Nanthaamornphong, Aziz},
  journal={IEEE Access}, 
  title={Analytical Validation and Integration of CIC-Bell-DNS-EXF-2021 Dataset on Security Information and Event Management}, 
  year={2024},
  volume={12},
  number={},
  pages={83043-83056},
  abstract={Contemporary culture presents a substantial obstacle for cyber security experts in the shape of software vulnerabilities, which, if taken advantage of, can jeopardize the Confidentiality, Integrity, and Availability (CIA) of any system. Data-driven and modern threat intelligence tools can enhance cyber security, bolster resilience, and foster innovation across cloud, multi-cloud, and hybrid platforms. As a result, performance evaluation and accuracy verification have become essential for Security Information and Event Management (SIEM) to prevent cyber threats. The SIEM system offers threat intelligence, reporting, and security incident management through the collection and analysis of event logs and other data sources that are specific to events and their context. We propose a hybrid strategy to address threat intelligence, reporting, and security incident management consisting of two layers that utilize a predefined set of characteristics. Here, we use RStudio to assess how well a hybrid intrusion detection system (HIDS) handles the CIC-Bell-DNS-EXF-2021 dataset. Furthermore, we have incorporated our developed model into Multi-Criteria Decision Analysis Methods (MCDM) to enhance the methods’ ability to identify complex DNS exfiltration attacks using machine learning algorithms: RF-AHP (RA), KNN-TOPSIS (KT), GBT-VIKOR (GV), and DT-Entropy-TOPSIS (DET). We consider several factors during the work, including accuracy, absolute error, weighted average recall, weighted average precision, kappa value, logistic loss, and root mean square deviation (RMSD). We use the Machine-Automated Model function to integrate and validate the models. According to the findings, GV has the highest level of accuracy, with a rate of 99.52%, while KT has the lowest level of authenticity, with a rate of 93.65%. Furthermore, these findings illustrate enhanced performance metrics for multiclass classification in comparison to previous approaches.},
  keywords={Security;Computer crime;Domain Name System;Servers;Computer hacking;Machine learning algorithms;MCDM;Computer security;Performance evaluation;Analytical models;Cyber security;SIEM;CIC-Bell-DNS-EXF-2021;HIDS;performance assessment;analytical validation;MCDM;machine learning},
  doi={10.1109/ACCESS.2024.3409413},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10911279,
  author={Singh, Shubham and Singh, Abhimanyu and Shridhar, A and Verma, Rajesh and Vishvakarma, S K},
  booktitle={2024 IEEE 4th International Conference on ICT in Business Industry & Government (ICTBIG)}, 
  title={The Rise of Intelligent Guardians: Leveraging AI for Robust Intrusion Detection}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper delves into the realm of Intrusion Detection Systems powered by Artificial Intelligence, specifically examining the revolutionary impact of machine learning algorithms in enhancing threat detection capabilities. Traditional intrusion detection methods often falter against novel threats and the sheer volume of network data. We delve into how machine learning, through anomaly detection and behavioural analysis, offers a dynamic and adaptive approach to identifying malicious activities, including the elusive "zero-day" attacks. Furthermore, we examine the crucial role of integrating these intelligent algorithms into Security Information and Event Management (SIEM) tools. The fusion empowers organizations to achieve comprehensive network visibility, real-time threat correlation, and proactive security posture management in the face of evolving cyber threats.},
  keywords={Machine learning algorithms;Correlation;Heuristic algorithms;Government;Network intrusion detection;Threat assessment;Real-time systems;Security;Ensemble learning;Faces;Network Intrusion Detection Systems;Ensemble Learning;XGBoost;Zero-Day Attacks;SIEM;Splunk},
  doi={10.1109/ICTBIG64922.2024.10911279},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10436884,
  author={Sebbar, Anass and Cherqi, Othmane and Chougdali, Khalid and Boulmalf, Mohammed},
  booktitle={GLOBECOM 2023 - 2023 IEEE Global Communications Conference}, 
  title={Real-Time Anomaly Detection in SDN Architecture Using Integrated SIEM and Machine Learning for Enhancing Network Security}, 
  year={2023},
  volume={},
  number={},
  pages={1795-1800},
  abstract={The Software-Defined Networking (SDN) paradigm has introduced heightened flexibility and scalability to network infrastructure management. However, the centralized control plane inherent in SDN architectures is susceptible to an array of security vulnerabilities, necessitating the development of efficient and real-time anomaly detection systems. This paper presents a novel integrated methodology for real-time anomaly detection within SDN architectures, capitalizing on the synergies between Security Information and Event Management (SIEM) systems and advanced machine learning techniques to bolster network security. The proposed framework operates by seamlessly collecting and analyzing live network traffic data, promptly pinpointing potential anomalies, and subsequently correlating these events via the SIEM system. To enhance accuracy while mitigating false positives, machine learning algorithms are harnessed to accurately categorize network traffic into benign and malicious activities, dynamically adapting to evolving threat landscapes. Empirical validation is conducted through an exhaustive dataset of real-world network traffic, encompassing an extensive array of attack scenarios. Findings vividly underscore the efficacy of the amalgamated SIEM and machine learning-driven anomaly detection system, yielding impressive detection accuracy while maintaining notably low rates of false positives. Noteworthy is the system's intrinsic adaptability to emergent threats, culminating in an elevated caliber of network security and fortitude within the SDN domain. This contribution significantly enriches the realm of real-time anomaly detection research, endowing SDN architectures with a pioneering strategy to counteract intricate cyber threats effectively.},
  keywords={Machine learning;Telecommunication traffic;Network security;Real-time systems;Threat assessment;Software defined networking;Anomaly detection;Software-Defined Networking (SDN);Security Information and Event Management (SIEM);Anomaly Detection;Machine Learning;Network Security;Real-time Analysis;Cyber Threats;Traffic Classification;False Positive Rates;Adaptive Security},
  doi={10.1109/GLOBECOM54140.2023.10436884},
  ISSN={2576-6813},
  month={Dec},}@INPROCEEDINGS{10754705,
  author={Ali, Md Liakat and Thakur, Kutub and Barker, Helen and Chan, Michael},
  booktitle={2024 IEEE 15th Annual Ubiquitous Computing, Electronics & Mobile Communication Conference (UEMCON)}, 
  title={The Rise of Artificial Intelligence: Industry Insights and Applications in Security Information and Event Management (SIEM)}, 
  year={2024},
  volume={},
  number={},
  pages={0477-0482},
  abstract={In recent years, Artificial Intelligence (AI) has become a focal point for companies, governments, and especially threat actors, all striving to improve system efficiency, efficacy, and responsiveness. By training complex systems based on the concept of a “neural network,” an artificial structure modeled after the pathways of the natural brain, machines are now capable of performing intricate tasks and automated processes independent of human control. Given this rapid development, several ethical considerations in data and cybersecurity must be managed or monitored. As laws and regulations continue to evolve, companies face critical decisions regarding how models are trained and how these models impact various stakeholders. After providing a general overview of the core functionalities and a technical description of Artificial Intelligence, machine learning, and the different types of AI, this paper delves into the current cybersecurity applications of AI, particularly focusing on its implementation in Security Information and Event Management (SIEM) systems and how this integration has revolutionized these technologies. Additionally, this paper offers an overview of various pioneering entities and their contributions to AI development, emerging AI trends, and diverse AI applications, including a range of AI leaders across different specialties, from generative AI to cybersecurity solutions.},
  keywords={Industries;Training;Shape;Companies;Brain modeling;Regulation;Stakeholders;Artificial intelligence;Computer security;Protection;Artificial Intelligence;SIEM;Machine Learning;Generative AI;Large Learning Module},
  doi={10.1109/UEMCON62879.2024.10754705},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{6717881,
  author={Cheng, Feng and Azodi, Amir and Jaeger, David and Meinel, Christoph},
  booktitle={2013 International Conference on IT Convergence and Security (ICITCS)}, 
  title={Security Event Correlation Supported by Multi-Core Architecture}, 
  year={2013},
  volume={},
  number={},
  pages={1-5},
  abstract={A huge amount of information about real-time events are being generated in every second in a running IT-Infrastructure and recorded by the system logs, application logs, as well as the output from the deployed security or management methods, e.g., IDS alerts, firewall logs, scanning reports, etc. To rapidly gather, process, correlate, and analyze the massive event information is a challenging task. High performance security analytics is proposed to address this challenge by which the real-time event information can be normalized, centralized, and correlated to help identify the current running state of the target environment. As an example of next generation Security Information and Event Management (SIEM) platform, Security Analytics Lab (SAL) has been designed and implemented based on the newly emerged In-Memory data management technique, which makes it possible to efficiently organize, access, and process different types of event information through a consistent central storage and interface. In this paper, the multi-core architecture is introduced on the event correlation module of SAL platform by which the correlation tasks can be executed in parallel by different computing resources. The k-means algorithm is implemented as an example of possible event clustering and correlation algorithms. Several experiments are conducted and analyzed to show that the performance of analytics can be significantly improved by applying multi-core architecture in the event correlation procedure.},
  keywords={Correlation;Clustering algorithms;Security;Parallel processing;Algorithm design and analysis;Multicore processing},
  doi={10.1109/ICITCS.2013.6717881},
  ISSN={},
  month={Dec},}@ARTICLE{11653272,
  author={Lazrag, Marwan and Hammi, Badis and Garcia-Alfaro, Joaquin and Araldo, Andrea and Zeadally, Sherali},
  journal={IEEE Consumer Electronics Magazine}, 
  title={Hybrid SIEM Architecture for Connected and Automated Vehicles}, 
  year={2026},
  volume={},
  number={},
  pages={1-9},
  abstract={Connected and Automated Vehicles (CAVs) are increasingly recognized as consumer electronics devices with stringent cybersecurity requirements.Traditional Security Information and Event Management (SIEM) architectures are difficult to deploy in Connected and Automated Vehicles (CAVs) because they must operate under bandwidth constraints, limited on-board resources, and strict latency requirements. This challenge must be addressed to enable effective event aggregation, correlation, and fleet-wide monitoring without overloading the vehicle or delaying security response. In this context, we present a hybrid SIEM architecture for CAVs, combining an on-board lightweight SIEM augmented by remote edge SIEM. The architecture uses a security event distribution strategy that incorporates lightweight AI-based event prioritization directly within the vehicle to filter, rank, and forward only the most relevant security events. We validate a proof of concept implementation of our architecture and we show that, compared to traditional SIEM architectures, in-vehicle processing significantly reduces the number of transmitted events by up to 89% and improves the detection latency by up to four times, while preserving global monitoring and cross-vehicle correlation.},
  keywords={Security information and event management;Vehicles;Architecture;Computer architecture;Security;Modeling;Monitoring;Signal detection;Artificial intelligence;Correlation},
  doi={10.1109/MCE.2026.3722161},
  ISSN={2162-2256},
  month={},}@INPROCEEDINGS{11606148,
  author={Khalfi, Loubna and Benbrahim, Houssam and Amine, Aouatif},
  booktitle={2026 International Conference on Intelligent Systems and Digital Applications (ISDA)}, 
  title={Predictive Intrusion Detection System: A Distributed Machine Learning Framework Integrated with Wazuh for Real-Time Network Threat Prediction}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={This article describes a predictive intrusion detection system that combines Wazuh SIEM and machine learning technologies to address the growing complexity of modern network threats. The system employs a distributed architecture and Random Forest classification methodology, trained on 1,000,107 network flows across eight distinct attack types, utilizing CICFlowMeter for comprehensive feature extraction from bidirectional network traffic. The framework achieves real-time processing capabilities with an overall accuracy of 92.34%, supported by a feature engineering pipeline that applies logarithmic transformations and correlation-based dimensionality reduction. Integration with Kibana and Elasticsearch enables enterprise-level implementation, offering MITRE ATT&CK framework mappings and advanced visualization capabilities that support security operations teams in rapid threat identification and response. The research demonstrates the viability of hybrid ML-SIEM architectures for contemporary network defense, processing over 1,000 flows per second with minimal latency while maintaining high detection accuracy across diverse attack categories including DDoS, DoS, Botnet, and web-based attacks. System resource utilization remains practical for production deployment, with detection memory below 500 MB and CPU utilization between 45–60% under full operational load.},
  keywords={Modeling;Signal detection;Fluid flow;Machine learning;Real-time systems;Timing;Security;Security information and event management;Pipelines;Random forests;Intrusion Detection;Machine Learning;Random Forest;Wazuh SIEM;Network Security;MITRE ATT&CK},
  doi={10.1109/ISDA70544.2026.11606148},
  ISSN={},
  month={May},}@INPROCEEDINGS{11348597,
  author={Hamza, Muhammad and Imdad, Maria and Anwar-ul-Hassan and Iqbal, Jawaid},
  booktitle={2025 27th International Multitopic Conference (INMIC)}, 
  title={Hybrid Deep Learning Architecture for SIEM Enhancement Using Novel Threat Intelligence Data}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={This research introduces an improved framework for Security Information and Event Management (SIEM) designed to enhance threat detection and security oversight. The proposed architecture follows a modular approach that optimizes log management, correlates security events more effectively, and supports real-time detection mechanisms. Key features of the system include flexible data integration, structured normalization, and interactive visualization capabilities. A detailed comparison between open-source and commercial SIEM tools is also provided. Furthermore, the incorporation of Security Orchestration, Automation, and Response (SOAR) functionalities is explored to facilitate automated threat mitigation and support forensic processes. Evaluation results indicate superior performance from individual models such as KNN (99.29 %), RNN (99.85 %), and Logistic Regression (97.25 %). In addition, hybrid approaches-LSTM with Random Forest $(93 \%)$, Linear Regression combined with LSTM (89 %), and CNN with KNN (99 %) demonstrate strong potential for accurate and reliable intrusion detection.},
  keywords={Logistic regression;Prevention and mitigation;Security information and event management;Nearest neighbor methods;Threat assessment;Real-time systems;Security;Reliability;Random forests;Long short term memory;LSTM;Random Forest;SIEM;Deep Learning;SOC;CNN;KNN},
  doi={10.1109/INMIC65900.2025.11348597},
  ISSN={2835-8864},
  month={Dec},}
