@ARTICLE{Uccello20251607,
	author = {Uccello, Federica and Pawlicki, Marek and D'Antonio, Salvatore and Kozik, Rafał and Choras, Michał},
	title = {A New Cybersecurity Approach Enhanced by xAI-Derived Rules to Improve Network Intrusion Detection and SIEM},
	year = {2025},
	journal = {Computers, Materials and Continua},
	volume = {83},
	number = {2},
	pages = {1607 - 1621},
	doi = {10.32604/cmc.2025.062801},
	url = {https://www.scopus.com/pages/publications/105003415230?origin=resultslist},
	affiliations = {Centro Direzionale, Department of Engineering, University of Naples, Parthenope’, Isola C4, Napoli, 80133, Italy; Department of Computer and Information Science, Software and Systems, Linköping University, Linköping, 58183, Sweden; ITTI Sp. z o.o., Poznań, 61-612, Poland; Faculty of Telecommunications, Computer Science and Electrical Engineering, Bydgoszcz University of Science and Technology, Bydgoszcz, 85-796, Poland},
	abstract = {The growing sophistication of cyberthreats, among others the Distributed Denial of Service attacks, has exposed limitations in traditional rule-based Security Information and Event Management systems. While machine learning–based intrusion detection systems can capture complex network behaviours, their “black-box” nature often limits trust and actionable insight for security operators. This study introduces a novel approach that integrates Explainable Artificial Intelligence—xAI—with the Random Forest classifier to derive human-interpretable rules, thereby enhancing the detection of Distributed Denial of Service (DDoS) attacks. The proposed framework combines traditional static rule formulation with advanced xAI techniques—SHapley Additive exPlanations and Scoped Rules - to extract decision criteria from a fully trained model. The methodology was validated on two benchmark datasets, CICIDS2017 and WUSTL-IIOT-2021. Extracted rules were evaluated against conventional Security Information and Event Management Systems rules with metrics such as precision, recall, accuracy, balanced accuracy, and Matthews Correlation Coefficient. Experimental results demonstrate that xAI-derived rules consistently outperform traditional static rules. Notably, the most refined xAI-generated rule achieved near-perfect performance with significantly improved detection of DDoS traffic while maintaining high accuracy in classifying benign traffic across both datasets. Copyright © 2025 The Authors.},
	author_keywords = {Cybersecurity; distributed denial of service; explainable artificial intelligence; intrusion detection system; rule-based SIEM},
	keywords = {Denial-of-service attack; Information management; Intrusion detection; Network intrusion; Cyber security; Cyberthreats; Denialof- service attacks; Distributed denial of service; Explainable artificial intelligence; Intrusion Detection Systems; Network intrusion detection; Rule based; Rule-based SIEM; Security information and event management systems; Cybersecurity},
	correspondence_address = {M. Choras; ITTI Sp. z o.o., Poznań, 61-612, Poland; email: chorasm@pbs.edu.pl},
	publisher = {Tech Science Press},
	issn = {15462218},
	language = {English},
	abbrev_source_title = {Comput. Mater. Continua},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5; All Open Access; Gold Open Access}
}

