@CONFERENCE{Zukhra2026,
	author = {Zukhra, Jumanova and Zebiniso, Abduvaliyeva and Sayyidafzalxo'ja, Rayimkhonov and Muzaffar, Mavlyanov and Madaminbek, Solijonov and Dilmurod, Yusupov},
	title = {Artificial Intelligence-Based Cybersecurity Framework for Uzbekistan's Digital Infrastructure: Detecting Network Intrusions in Telecommunication and IoT Systems},
	year = {2026},
	journal = {International Conference of Young Specialists on Micro/Nanotechnologies and Electron Devices, EDM},
	pages = {},
	doi = {10.1109/EDM69524.2026.11632139},
	url = {https://www.scopus.com/pages/publications/105048091690?origin=resultslist},
	affiliations = {Cyber University, Nurafshon, Uzbekistan},
	abstract = {The rapid digitalization of critical services and the widespread deployment of Internet of Things (IoT) devices have significantly expanded the attack surface of modern telecommunication infrastructures. Traditional signature-based intrusion detection systems are increasingly ineffective against evolving, encrypted, and multi-stage cyber threats, particularly in high-volume and heterogeneous network environments. This study proposes a hybrid artificial intelligence-based intrusion detection framework for telecom and IoT networks. The proposed approach integrates multi-source network telemetry using flow-based and statistical traffic features and combines three complementary components: Gradient Boosted Decision Trees for fast edge-level classification, an autoencoder for unsupervised anomaly detection under weak labeling conditions, and a temporal sequence learning model (LSTM) to capture time-dependent attack behavior. The framework is designed to provide stable detection performance under heterogeneous traffic conditions while maintaining feasibility for real-time operational deployment. The proposed model was evaluated using three publicly available benchmark datasets: CIC-IDS2017, UNSW-NB15, and IoT-23. Experimental results show accuracy values between 90.2% and 92.8% and F1-scores ranging from 89.4% to 91.7%, outperforming traditional machine learning baselines such as Logistic Regression and Random Forest. The results demonstrate that the proposed framework provides a scalable and operationally practical solution for enhancing intrusion detection in telecom and IoT environments and supports effective integration into Security Operations Center (SOC) workflows. © 2026 IEEE.},
