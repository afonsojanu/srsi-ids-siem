	title = {Aggressive and Intelligent Self-Defensive Network: Towards a New Generation of Semi-autonomous Networks},
	year = {2012},
	journal = {Communications in Computer and Information Science},
	volume = {293 PART 1},
	pages = {344 - 354},
	doi = {10.1007/978-3-642-30507-8_30},
