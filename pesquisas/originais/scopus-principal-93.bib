@CONFERENCE{Kim2020277,
	author = {Kim, Minchul and Park, Youngwoo and Han, Insung and Cho, Sungyoung},
	title = {A fast alert correlation method with Bayesian feature constraints},
	year = {2020},
	journal = {Proceedings of the 15th International Conference on Cyber Warfare and Security, ICCWS 2020},
	pages = {277 - 285},
	doi = {10.34190/ICCWS.20.042},
	url = {https://www.scopus.com/pages/publications/85083369877?origin=resultslist},
	affiliations = {Agency for Defense Development, Seoul, South Korea},
	abstract = {Today's Intrusion Detection System (IDS) and Security Information & Event Management (SIEM) generate a tremendous number of alerts every minute, making it difficult to analyze raw alerts manually. Consequently, there have been many studies about correlating alerts and extracting useful information from the resulting correlation. Among those approaches, statistical alert analysis using Bayesian probability has distinct advantages that it requires no prior knowledge and is able to detect patterns solely from the alert data itself. This method correlates pairs of alert types that occur frequently within a short time segment and identify features associated with the frequency of the patterns. However, previous researches have mainly focused on defining Bayesian correlations in formulas rather than on the efficiency of implemented algorithms. In this paper, we rigorously formalize the Bayesian alert correlation problem and propose an efficient algorithm to compute it. First, we formally define the concept of `feature constraint` and explain how it can be used to define Bayesian correlations between alert types. By introducing functional concepts into modelling features, multiple features can be combined into one composite constraint - which can be treated as a single feature constraint without any additional consideration. Next, we suggest an algorithm to calculate the correlation values. The time-complexity analysis demonstrates that our algorithm is a significant improvement over the naive method. In particular, the processing time of the previous method depends not only on the total number of alerts, but also on the number of alerts per time segment. This limits performance when you need to analyze with longer time segments. However, the processing time of our algorithm simply depends on the total number of alerts with the types of interest. The proposed algorithm guarantees to correlate each pair of alert types - N alerts total - in O(N log N) time per feature, while the naive method spends O(N<sup>2</sup>) time in the worst case scenario. Finally, we implemented our algorithm and benchmark its practical efficiency. © 2020. the authors. All Rights Reserved.},
	author_keywords = {Alert correlation; Algorithm; Bayesian probability; Time-complexity analysis},
	keywords = {Computer crime; Efficiency; Intrusion detection; Network security; Alert correlation; Bayesian probabilities; Correlation value; Event management; Intrusion Detection Systems; Multiple features; Time complexity analysis; Worst case scenario; Information management},
