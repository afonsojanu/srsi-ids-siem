	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; Conference name: 15th International Conference on Cyber Warfare and Security, ICCWS 2020; Conference sponsors: ; Conference code: 158670; Conference date: 12 March 2020 through 13 March 2020}
}

