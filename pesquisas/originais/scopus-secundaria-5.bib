@ARTICLE{Fourati2026,
	author = {Fourati, Lamia Chaari and Awad, Mirna and Ben Ali, Mariem and Jaafar, Wael},
	title = {Large language models for cyberattack defense: a critical survey},
	year = {2026},
	journal = {Knowledge and Information Systems},
	volume = {68},
	number = {1},
	pages = {},
	doi = {10.1007/s10115-026-02736-y},
	url = {https://www.scopus.com/pages/publications/105035318029?origin=resultslist},
	abstract = {Large Language Models (LLMs) are increasingly explored as defender-side intelligence components that can interpret heterogeneous security artifacts and support decision-making across the cyber defense lifecycle. In network and application security, recent studies investigate LLMs not only as semantic reasoning engines for unstructured inputs (e.g., alerts, logs, threat intelligence narratives, phishing content, and code artifacts), but also as modules integrated into IDS/SOC pipelines for detection, triage, explanation, and as retrieval- and tool-augmented agents that assist mitigation and response under controlled execution. This survey provides an analysis-driven review of LLM-based approaches for cyberattack detection and mitigation across major attack families, including DoS/DDoS, phishing, malware, SQL injection, cross-site scripting (XSS), eavesdropping, and man-in-the-middle (MITM). Beyond cataloging the literature, we introduce a unified taxonomy that separates detection from mitigation objectives and systematically compare representative solutions in terms of modeling strategy (prompting, fine-tuning, retrieval-augmented generation, and agentic tool use), data modality, and evaluation setting. We further emphasize feasibility by discussing operational constraints such as latency and throughput, integration with SIEM/SOAR/EDR platforms, compute and maintenance costs, and generalization under domain shift. Finally, we examine LLM-specific risks that affect real-world adoption, including prompt injection, poisoned retrieval context, hallucinated recommendations, and tool/agent misuse, and summarize assurance mechanisms and open research challenges toward reliable and deployable LLM-enabled cyber defense. © The Author(s), under exclusive licence to Springer-Verlag London Ltd., part of Springer Nature 2026.},
	author_keywords = {Cyber attack detection; Intrusion detection; Large language models; LLMs; Network security},
	keywords = {Decision making; Denial-of-service attack; Information retrieval; Intrusion detection; Malware; Search engines; Security systems; Semantics; Attack detection; Cybe attack detection; Cyber-attacks; Cyber-defense; Intrusion-Detection; Language model; Large language model; Networks security; Network security},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Alarcon2026347,
	author = {Alarcon, Alan Ignacio Delgado and Anaya, Eleazar Aguirre and Duarte, Nidia Asunción Cortez and Rodríguez, Florencio Javier González},
	title = {Rethinking Dynamic Security Strategies: A Survey of Moving Target Defense and Self-Defending Systems Design},
	year = {2026},
	journal = {Communications in Computer and Information Science},
	volume = {2704 CCIS},
	pages = {347 - 369},
	doi = {10.1007/978-3-032-09735-4_20},
	url = {https://www.scopus.com/pages/publications/105021831768?origin=resultslist},
	abstract = {This survey examines recent strategic approaches to Moving Target Defense (MTD) and self-defending systems, focusing on their strategy design, reconfiguration mechanisms, and adaptive behavior within cybersecurity contexts. Through a structured review of scientific literature, the study classifies existing approaches across multiple groups, including strategic objectives, threat models, control models, agent integration, and protected assets. The classification reveals recurring patterns, unresolved challenges, and conceptual gaps, particularly the common tendency to reduce strategies to isolated technical mechanisms. This observation motivates a rethinking of how strategy is defined and design in cybersecurity defense systems. As a contribution, the article presents StratEDR, a novel conceptual MTD strategy based on a language-model-driven agent that governs behavioral inspection and movement decisions within a honeypot environment. Suspicious traffic, flagged by external systems such as SIEM or IDS, is redirected to this environment, where the agent analyzes activity prior to authorizing access to the production infrastructure. The insights and classification framework offered in this work are intended to support researchers and professionals in analyzing, comparing, and designing dynamic defense strategies with greater architectural clarity and strategic intent. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	author_keywords = {Cybersecurity survey; Dynamic cyber defense; Moving Target Defense; Security strategy classification; Self-defending systems},
	keywords = {Cybersecurity; Dynamics; Network security; Security systems; Systems analysis; Cyber security; Cyber-defense; Cybersecurity survey; Defense strategy; Dynamic cybe defense; Dynamic security; Moving target defense; Security strategies; Security strategy classification; Self-defending system; Design},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Hubballi20141,
	author = {Hubballi, Neminath and Suryanarayanan, Vinoth},
	title = {False alarm minimization techniques in signature-based intrusion detection systems: A survey},
	year = {2014},
	journal = {Computer Communications},
	volume = {49},
	pages = {1 - 17},
	doi = {10.1016/j.comcom.2014.04.012},
	url = {https://www.scopus.com/pages/publications/84903312615?origin=resultslist},
	abstract = {A network based Intrusion Detection System (IDS) gathers and analyzes network packets and report possible low level security violations to a system administrator. In a large network setup, these low level and partial reports become unmanageable to the administrator resulting in some unattended events. Further it is known that state of the art IDS generate many false alarms. There are techniques proposed in IDS literature to minimize false alarms, many of which are widely used in practice in commercial Security Information and Event Management (SIEM) tools. In this paper, we review existing false alarm minimization techniques in signature-based Network Intrusion Detection System (NIDS). We give a taxonomy of false alarm minimization techniques in signature-based IDS and present the pros and cons of each class. We also study few of the prominent commercial SIEM tools which have implemented these techniques along with their performance. Finally, we conclude with some directions to the future research. © 2014 Elsevier B.V. All rights reserved.},
	author_keywords = {Correlation; False alarms; Intrusion detection},
	keywords = {Alarm systems; Computer crime; Correlation methods; Intrusion detection; False alarms; Intrusion Detection Systems; Minimization techniques; Network based intrusion detection systems; Security information and event management (SIEM); Security violations; Signature-based network intrusion detection systems; System administrators; Errors},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 233}
}

@CONFERENCE{Lakkaraju2026,
	author = {Lakkaraju, Yatin and Prasad, Gaurav and Sarma, Akash},
	title = {Comprehensive Survey of Security Information and Event Management (SIEM) Systems},
	year = {2026},
	journal = {IEEE International Conference on Emerging Synergy Science and Technology, ICESST 2026},
	pages = {},
	doi = {10.1109/ICESST69086.2026.11582879},
	url = {https://www.scopus.com/pages/publications/105045219087?origin=resultslist},
	abstract = {With the evolving digital landscape, the threat of cyber attacks has never been greater. Attackers are nowadays using sophisticated techniques to carry complicated and multilayered attacks which make traditional cyber-defense tools like firewalls, IDS, and IPS inefficient. The traditional tools lack in capabilities of correlation of data, event management and investigations, and efficient usage of External data like Threat Intelligence. Organizations nowadays employ different security information and event management (SIEM) tools to combat such complex attacks. SIEM tools can ingest huge amounts of data from different sources including traditional security tools like IDS, Firewall, and IPS. These tools have advanced defense capabilities as they employ different features like data correlation, Threat Intelligence, Compliance, etc. This paper first provides a small analysis of the features of different SIEM tools widely used in the industry. It also provides different SIEM frameworks proposed in the academic field that use various technologies like AI, Cloud, etc. © 2026 IEEE.},
	author_keywords = {AI in SIEM; Anomaly Detection; Cloud-based SIEM; Event Correlation; Security Analytics; SIEM; SOAR},
	keywords = {Advanced Analytics; Application programs; Artificial intelligence; Computer crime; Information management; Network security; AI in security information and event management; Anomaly detection; Cloud-based; Cloud-based security information and event management; Event correlation; Security Analytics; Security information and event managements; SOAR; Anomaly detection},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

